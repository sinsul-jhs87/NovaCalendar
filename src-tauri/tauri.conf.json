{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NovaCalendar",
  "version": "1.12.2",
  "identifier": "com.widgetcalendar.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NovaCalendar",
        "url": "index.html",
        "width": 600,
        "height": 540,
        "minWidth": 360,
        "minHeight": 300,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnBottom": true,
        "skipTaskbar": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "바탕화면 위젯 캘린더",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "icons/alt/NovaCalendar-default.ico": "icons/NovaCalendar-default.ico",
      "icons/alt/NovaCalendar-orbit.ico": "icons/NovaCalendar-orbit.ico",
      "icons/alt/NovaCalendar-fluent.ico": "icons/NovaCalendar-fluent.ico"
    }
  },
  "mainBinaryName": "NovaCalendar"
}
